# Project Eclipse - Git attributes
# Normalize text files across Windows/macOS/Linux.

* text=auto

# Source code and project files
*.cs          text eol=lf
*.shader      text eol=lf
*.cginc       text eol=lf
*.hlsl        text eol=lf
*.compute     text eol=lf

*.json        text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf

# Unity serialized text assets
*.meta        text eol=lf
*.unity       text eol=lf
*.prefab      text eol=lf
*.asset       text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.spriteatlas text eol=lf
*.inputactions text eol=lf
*.asmdef      text eol=lf
*.asmref      text eol=lf

# Shell scripts
*.sh          text eol=lf
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Binary assets
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.psd         binary
*.tga         binary

*.wav         binary
*.mp3         binary
*.ogg         binary

*.fbx         binary
*.blend       binary

*.ttf         binary
*.otf         binary

*.dll         binary
*.so          binary
*.dylib       binary